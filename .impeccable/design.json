  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The current explicit project action.",
      "html": "<button class=\"ds-primary\">Accept plan</button>",
      "css": ".ds-primary{font:600 14px 'Segoe UI',system-ui,sans-serif;min-height:36px;padding:8px 12px;border:1px solid #286cde;border-radius:7px;background:#286cde;color:white}.ds-primary:hover{background:#2266d2}.ds-primary:focus-visible{outline:3px solid #93c2ff;outline-offset:3px}"
    },
    {
      "name": "Project input",
      "kind": "input",
      "description": "Persistent label and native text input.",
      "html": "<label class=\"ds-input\">Project title<input placeholder=\"e.g. Launch my website\"></label>",
      "css": ".ds-input{display:grid;gap:8px;font:600 16px 'Segoe UI',system-ui,sans-serif;color:#f0f3f8}.ds-input input{font:inherit;font-weight:400;min-height:44px;padding:10px 12px;border:1px solid #566273;border-radius:8px;background:#1a1d22;color:#f0f3f8}.ds-input input::placeholder{color:#adb7c6}.ds-input input:focus-visible{outline:3px solid #93c2ff;outline-offset:3px}"
    },
    {
      "name": "Narrow navigation",
      "kind": "nav",
      "description": "Projects, workspace or manager conversation below 1000px.",
      "html": "<nav class=\"ds-nav\"><button>Projects</button><button aria-pressed=\"true\">Workspace</button><button>Chat</button></nav>",
      "css": ".ds-nav{display:flex;gap:8px;background:#121519;padding:12px 20px}.ds-nav button{flex:1;min-width:0;overflow-wrap:anywhere;font:600 14px 'Segoe UI',system-ui,sans-serif;min-height:44px;padding:10px 8px;border:1px solid #566273;border-radius:8px;background:#1a1d22;color:#f0f3f8}.ds-nav button[aria-pressed=true]{background:#26364b;border-color:#93c2ff}.ds-nav button:focus-visible{outline:3px solid #93c2ff;outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "The project desk",
    "overview": "An original compact charcoal project desk shows actual progress, next action, connected steps, task/evidence/notes cards, check-in and manager together.",
    "keyCharacteristics": [
      "Compact three-column workspace",
      "Recorded data and connected steps",
      "Bounded collections and retained detail editors",
      "Unchanged approved mouse and light native pet"
    ],
    "rules": [
      {
        "name": "Recorded progress",
        "body": "Green and progress counts describe real task records; unknown stays unknown.",
        "section": "colors"
      },
      {
        "name": "Capability truth",
        "body": "Source permissions, cloud connection and model availability remain distinct.",
        "section": "components"
      }
    ],
    "dos": [
      "Preserve drafts and focused editors",
      "Label synthetic mode",
      "Keep privacy controls directly reachable"
    ],
    "donts": [
      "No fabricated metrics or integrations",
      "No automatic fixture fallback",
      "No copied board composition"
    ]
  }
