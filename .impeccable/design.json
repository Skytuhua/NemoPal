{
  "schemaVersion": 2,
  "title": "Design System: Living Playbooks",
  "extensions": {
    "motion": [{ "name": "control-transition", "value": "160ms ease-out", "purpose": "Control feedback only; disabled with reduced motion." }],
    "breakpoints": [{ "name": "compact-desktop", "value": "1200px" }, { "name": "single-surface", "value": "1000px" }],
    "focus": [{ "name": "keyboard-focus", "value": "3px solid var(--focus)", "purpose": "Visible focus with 3px offset." }]
  },
  "components": [{
    "name": "Primary action", "kind": "button", "refersTo": "button-primary", "description": "The current explicit project action.",
    "html": "<button class=\"ds-primary\">Accept plan</button>",
    "css": ".ds-primary{font:600 16px 'Segoe UI',system-ui,sans-serif;min-height:44px;padding:10px 12px;border:1px solid #286cde;border-radius:8px;background:#286cde;color:white}.ds-primary:hover{background:#2266d2}.ds-primary:focus-visible{outline:3px solid #93c2ff;outline-offset:3px}"
  }, {
    "name": "Project input", "kind": "input", "description": "Persistent label and native text input.",
    "html": "<label class=\"ds-input\">Project title<input placeholder=\"e.g. Launch my website\"></label>",
    "css": ".ds-input{display:grid;gap:8px;font:600 16px 'Segoe UI',system-ui,sans-serif;color:#f1f2f4}.ds-input input{font:inherit;font-weight:400;min-height:44px;padding:10px 12px;border:1px solid #626b79;border-radius:8px;background:#1b1d21;color:#f1f2f4}.ds-input input::placeholder{color:#b0b6c0}.ds-input input:focus-visible{outline:3px solid #93c2ff;outline-offset:3px}"
  }, {
    "name": "Narrow navigation", "kind": "nav", "description": "Projects, workspace or manager conversation below 1000px.",
    "html": "<nav class=\"ds-nav\"><button>Projects</button><button aria-pressed=\"true\">Workspace</button><button>Chat</button></nav>",
    "css": ".ds-nav{display:flex;gap:8px;background:#151619;padding:12px 20px}.ds-nav button{flex:1;min-width:0;overflow-wrap:anywhere;font:600 14px 'Segoe UI',system-ui,sans-serif;min-height:44px;padding:10px 8px;border:1px solid #626b79;border-radius:8px;background:#1b1d21;color:#f1f2f4}.ds-nav button[aria-pressed=true]{background:#2b3442;border-color:#93c2ff}.ds-nav button:focus-visible{outline:3px solid #93c2ff;outline-offset:3px}"
  }],
  "narrative": {
    "northStar": "The project desk",
    "overview": "Calm charcoal surfaces, direct actions and plain language help a first-time project owner find the next useful step.",
    "keyCharacteristics": ["Readable task-first workspace", "Recognizable project navigation", "Progressive disclosure", "Unchanged approved mouse"],
    "rules": [{ "name": "Recorded progress", "body": "Green and progress counts describe real task records; unknown stays unknown.", "section": "colors" }, { "name": "Capability truth", "body": "Source permissions, cloud connection and model availability remain distinct.", "section": "components" }],
    "dos": ["Preserve drafts and focused editors", "Label synthetic mode", "Keep privacy controls directly reachable"],
    "donts": ["No fabricated metrics or integrations", "No automatic fixture fallback", "No copied board composition"]
  }
}
