{
  "name": "living-playbooks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "test:cloud": "vitest run tests/cloud --maxWorkers=1 --no-file-parallelism",
    "test:desktop": "vitest run tests/desktop",
    "test:ui": "vitest run tests/ui",
    "test:e2e": "playwright test",
    "test:native": "tsx scripts/verify-live.ts native",
    "test:live:model": "tsx scripts/verify-live.ts model",
    "test:live:observer": "tsx scripts/verify-live.ts observer",
    "test:live": "tsx scripts/verify-live.ts golden",
    "db:migrate": "tsx apps/cloud/src/db/migrate.ts",
    "owner:grant": "tsx apps/cloud/src/auth/grant.ts",
    "dev:cloud": "tsx apps/cloud/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:desktop": "tsx scripts/run-desktop.ts",
    "build": "tsx scripts/build.ts",
    "package:win": "tsx scripts/verify-live.ts package",
    "evidence:check": "tsx scripts/check-evidence.ts"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
