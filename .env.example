# Cloud secrets stay on the cloud. Never commit an actual .env.
DATABASE_URL=
PUBLIC_ORIGIN=http://127.0.0.1:4310
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
LP_MODEL_CALL_BUDGET=
LP_JOB_DEADLINE_MS=120000
LP_DEMO_TIMING=false
LP_ENABLE_MCP=false
LP_ENABLE_PHONE_VIEW=false
LP_ENABLE_SMS=false
LP_FIXTURE_MODE=false
# Optional local thread MCP and desktop view. Export these in the launch environment.
# No automatic cloud model connection or transcript sharing is enabled.
NEMOPAL_T3_THREAD_ID=
NEMOPAL_T3_CLI=
LP_CLOUD_ORIGIN=http://127.0.0.1:4310
# Live gates additionally require LP_LIVE_TEST_OPT_IN=1 and explicit selection.
